{
	// Everything that runs in a browser, or in neither runtime in particular. Type checking only:
	// a library here exports .ts straight from src and its consumers bundle it, so nothing emits.
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": ["es2023", "dom"]
	},
	"include": ["apps/**/*.ts", "libs/**/*.ts", "*.ts"],
	"exclude": [
		"**/node_modules",
		"**/dist",
		"**/build",
		// Checked by svelte-check instead: SvelteKit generates the `$lib` and `$app` aliases and the
		// `*.svelte` module types elsewhere, so this file alone sees half a project.
		"apps/panel"
	]
}
