RELAY_PORT = 12012
# The roles host's `GRANTS` names on every node, and the steward that updates it, by family. See
# platform's spec/architecture/cron.md, apt.md and packages.md.
GRANTS = {
	"debian": ("relay:peer", "cron:scheduler", "apt:steward"),
	"alpine": ("relay:peer", "cron:scheduler", "apk:steward"),
}
# What a core node grants besides: the platform's Postgres, a peer publishing 5432, and the objects
# driver, whose sidecars the platform's apps there run. See platform's
# spec/architecture/databases.md, "Where it runs, and which one writes", and objects.md.
CORE_GRANTS = ("database:peer", "objects:objects")
# The private scopes host's Caddy sends to the gateway; see spec/architecture/host.md.
PRIVATE_SCOPES = "ledger"
# The secrets every node shares, in secrets.json under these names.
RELAY_SECRETS = ("HOST_READ_TOKEN", "RELAY_SECRET")

# Runs on the node with RELAY_SECRET, HOST_READ_TOKEN, RELAY_PEERS, the node's slot, the grants it
# needs, PRIVATE_SCOPES, what it emulates and where its canary is on stdin, a line each. Values
# travel by stdin and environment only, never argv. A file is replaced only when its content
# differs, and what it holds besides the keys named is kept, GRANTS's other pairs too. Prints
# `secret <state>` and `host <state>`, a state being current, changed or absent.
RELAY = r"""set -eu
umask 077
read -r secret
read -r token
read -r peers
read -r slot
read -r wanted
read -r scopes
read -r emulate
read -r canary
upsert() {
	file=$1
	shift
	cp -p "$file" "$file.new" 2>/dev/null || : > "$file.new"
	for pair in "$@"; do
		K=${pair%%=*} V=${pair#*=} awk 'BEGIN { k = ENVIRON["K"]; v = ENVIRON["V"] }
			index($0, k "=") == 1 { if (!d) print k "=" v; d = 1; next }
			{ print }
			END { if (!d) print k "=" v }' "$file.new" > "$file.tmp"
		mv "$file.tmp" "$file.new"
	done
	if [ -f "$file" ] && cmp -s "$file.new" "$file"; then
		rm -f "$file.new"
		echo current
	else
		chown root:root "$file.new"
		chmod 600 "$file.new"
		mv "$file.new" "$file"
		echo changed
	fi
}
mountpoint -q /data || { echo "/data is not mounted" >&2; exit 1; }
mkdir -p /data/apps
dir=/data/apps/relay
[ -d "$dir" ] || btrfs subvolume create "$dir" >/dev/null
chmod 700 "$dir"
echo "secret $(upsert "$dir/secret.env" "RELAY_SECRET=$secret" "HOST_READ_TOKEN=$token" "RELAY_PEERS=$peers")"
file=/data/apps/host/.env
if [ -f "$file" ]; then
	grants=$(sed -n 's/^GRANTS=//p' "$file" | tail -n 1)
	for pair in $wanted; do
		case " $grants " in
			*" $pair "*) ;;
			*) grants="${grants:+$grants }$pair" ;;
		esac
	done
	echo "host $(upsert "$file" "HOST_READ_TOKEN=$token" "GRANTS=$grants" "NODE_SLOT=$slot" \
		"PRIVATE_SCOPES=$scopes" "EMULATE=$emulate" "CANARY=$canary")"
else
	echo "host absent"
fi
"""

