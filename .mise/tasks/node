def firewall(node):
	trusted = ["lo", "tailscale0", "docker0"] + ([node["lan"]] if "lan" in node else [])
	text = (NODES / "firewall.nft").read_text()
	return text.replace("@TRUSTED@", ", ".join(f'"{name}"' for name in trusted))


def proxy_conf(family):
	identity = PROXY[family]["identity"]
	text = (NODES / "tinyproxy.conf").read_text()
	return text.replace("@IDENTITY@\n", identity + "\n" if identity else "")


def proxy(family):
	"""Installs the egress proxy and restarts it only when what it reads changed."""
	steps = PROXY[family]
	lines = ["command -v tinyproxy >/dev/null || " + steps["install"], steps["prepare"],
		"mkdir -p /etc/tinyproxy", "changed=0"]
	files = (("tinyproxy.conf", proxy_conf(family)), ("filter", (NODES / "tinyproxy.filter").read_text()))
	for file, text in files:
		path = f"/etc/tinyproxy/{file}"
		lines += [
			f"printf '%s' {encoded(text)} | base64 -d > {path}.new",
			f"cmp -s {path}.new {path} || changed=1",
			f"mv {path}.new {path}",
		]
	lines.append(steps["enable"])
	lines.append(f'if [ "$changed" = 1 ] || ! {steps["running"]}; then {steps["restart"]}; fi')
	return "\n".join(lines) + "\n"


# Runs on a node with no IPv4, with the proxies in `want`. host and keeper read the line when they
# are next recreated, so nothing is restarted. See spec/architecture/nodes.md, "The nodes".
def egress(proxies):
	line = "EGRESS_PROXIES=" + " ".join(proxies)
	return f"""file=/data/apps/host/.env
want={shlex.quote(line)}
if [ ! -f "$file" ]; then
	echo "node: $file does not exist; EGRESS_PROXIES is not set"
elif grep -qxF -- "$want" "$file"; then
	echo "node: EGRESS_PROXIES is current"
else
	umask 077
	{{ grep -v '^EGRESS_PROXIES=' "$file" || true; printf '%s\\n' "$want"; }} > "$file.new"
	chown root:root "$file.new"
	chmod 600 "$file.new"
	mv "$file.new" "$file"
	echo "node: EGRESS_PROXIES is written"
fi
"""


def proxy_addresses(nodes):
	"""Each proxy node's tailnet IPv4, in nodes.toml order with the home tier last."""
	proxies = [name for name, node in nodes.items() if node.get("ipv4", True)]
	proxies.sort(key=lambda name: nodes[name]["tier"] == "home")
	return [f"http://{tailnet_ipv4(name)}:{PROXY_PORT}" for name in proxies]


def tailnet_ipv4(name):
	found = subprocess.run(["tailscale", "ip", "-4", name], text=True, stdout=subprocess.PIPE)
	address = found.stdout.split()[0] if found.returncode == 0 and found.stdout.split() else None
	if address is None:
		sys.exit(f"node: tailscale has no IPv4 for {name}")
	return address


def apt_units():
	"""Installs apt's units and stops whatever else updates a Debian machine. See platform's
	spec/architecture/apt.md, "Every Debian node runs `apt`, and nothing else updates it"."""
	if not APT_UNITS.is_dir():
		sys.exit(f"node: {APT_UNITS} is missing; clone the platform beside infra")
	lines = []
	for unit in sorted(APT_UNITS.glob("*.service")):
		target = f"/etc/systemd/system/{unit.name}"
		lines.append(f"printf '%s' {encoded(unit.read_text())} | base64 -d > {target}")
		lines.append(f"chmod 644 {target}")
	lines.append("systemctl daemon-reload")
	lines.append(
		"for timer in apt-daily.timer apt-daily-upgrade.timer; do\n"
		'\tif systemctl cat "$timer" >/dev/null 2>&1; then systemctl disable --now --quiet "$timer"; fi\n'
		"done"
	)
	lines.append(
		"if dpkg-query -W -f='${Status}' unattended-upgrades 2>/dev/null | grep -q ' installed$'; then\n"
		"\tDEBIAN_FRONTEND=noninteractive apt-get purge -y -qq -o DPkg::Lock::Timeout=600 unattended-upgrades >/dev/null\n"
		"fi"
	)
	return "\n".join(lines) + "\n"


def apk_door():
	"""Installs apk's door, enabled at boot, and restarts it only when a file it runs changed or it
	is not running. See platform's spec/architecture/packages.md, "`apk` reaches the machine through
	a named pipe"."""
	missing = [name for name, _ in APK_DOOR_FILES if not (APK_DOOR / name).is_file()]
	if missing:
		sys.exit(f"node: {APK_DOOR} has no {', '.join(missing)}; the platform beside infra carries them")
	lines = ["changed=0"]
	for name, target in APK_DOOR_FILES:
		lines += [
			f"mkdir -p {Path(target).parent}",
			f"printf '%s' {encoded((APK_DOOR / name).read_text())} | base64 -d > {target}.new",
			f"chmod 755 {target}.new",
			f"cmp -s {target}.new {target} || changed=1",
			f"mv {target}.new {target}",
		]
	lines.append("rc-update add apk-door default >/dev/null")
	lines.append(
		'if [ "$changed" = 1 ] || ! rc-service --quiet apk-door status; then rc-service --quiet apk-door restart; fi'
	)
	return "\n".join(lines) + "\n"


# The architectures a node may emulate, and the family whose packages set it up: arm64 alone, on
# Debian alone. Alpine packages QEMU's user mode too, but nothing here has proved its registration
# fixed at load, and no Alpine node is x86 to need it. See spec/architecture/nodes.md, "An x86 node
# may run arm64 images, emulated, and never the other way".
EMULATES = ("arm64",)
EMULATING = "debian"

# Runs on a node that emulates arm64: on x86 alone, QEMU's user mode installed unless it is, and its
# registration with binfmt_misc checked enabled and fixed, the F flag, so a container needs no
# emulator of its own. host reads EMULATE, given beside GRANTS, to run arm64 images there.
EMULATION = r"""machine=$(uname -m)
[ "$machine" = x86_64 ] || { echo "emulate is for an x86 node, and this one is $machine" >&2; exit 1; }
if ! dpkg-query -W -f='${Status}' qemu-user-binfmt 2>/dev/null | grep -q ' installed$'; then
	DEBIAN_FRONTEND=noninteractive apt-get install -y -qq -o DPkg::Lock::Timeout=600 qemu-user-binfmt >/dev/null
fi
entry=/proc/sys/fs/binfmt_misc/qemu-aarch64
[ -f "$entry" ] || systemctl restart systemd-binfmt
if ! grep -qx enabled "$entry" || ! sed -n 's/^flags: //p' "$entry" | grep -q F; then
	echo "qemu-aarch64 is not registered enabled and fixed (F) in binfmt_misc" >&2
	exit 1
fi
"""


def emulated(node):
	"""What host's EMULATE names on `node`: the architectures it emulates, space-separated."""
	return " ".join(node.get("emulate", ()))


def emulation_refused(name, node):
	"""Why `node`'s `emulate` cannot be, or None when it can."""
	emulate = node.get("emulate")
	if emulate is None:
		return None
	if not isinstance(emulate, list) or not emulate or any(arch not in EMULATES for arch in emulate):
		return f"{name}: emulate is a list of {', '.join(EMULATES)} alone, not {emulate!r}"
	if node.get("system") != EMULATING:
		return f"{name}: emulate is set up on {EMULATING} alone, and {name} is {node.get('system')}"
	return None


# A failure domain as the platform's registry of providers writes it: a code of two or three
# letters, and a number after it for a second account. See spec/architecture/nodes.md.
DOMAIN = re.compile(r"[a-z]{2,3}(-[0-9]+)?")


def domain_refused(name, node):
	"""Why `node`'s `domain` is not a provider's code, or None when it is."""
	domain = node.get("domain")
	if isinstance(domain, str) and DOMAIN.fullmatch(domain):
		return None
	return f"{name}: domain is a provider's code like oci, az or oci-2, not {domain!r}"


def canaries_refused(nodes):
	"""Why the nodes do not name exactly one canary, `canary = true`, or nothing when they do."""
	marked = [name for name, node in nodes.items() if "canary" in node]
	canaries = [name for name in marked if nodes[name]["canary"] is True]
	if len(marked) != len(canaries):
		return [f"{', '.join(sorted(set(marked) - set(canaries)))}: canary is true or left out"]
	if len(canaries) != 1:
		return [f"exactly one node is the canary, canary = true, and {len(canaries)} are"]
	return []


def canary_of(name, nodes):
	"""What host's and keeper's CANARY say on `name`: `self` on the canary, and on every other node
	the canary's tailnet IPv4, which they ask its verdict at before taking a new host, keeper or
	Caddy. See spec/architecture/host.md, "A new host, keeper or Caddy reaches the canary first"."""
	canary = next(other for other, node in nodes.items() if node.get("canary") is True)
	return "self" if canary == name else tailnet_ipv4(canary)


def load_nodes():
	"""nodes.toml, every node's `domain` and `emulate`, and the one canary, checked before anything
	is asked of a machine."""
	nodes = tomllib.loads((NODES / "nodes.toml").read_text())
	checks = (domain_refused, emulation_refused)
	refused = [why for name, node in nodes.items() for check in checks if (why := check(name, node))]
	refused += canaries_refused(nodes)
	if refused:
		sys.exit("node: " + "\nnode: ".join(refused))
	return nodes


def grants(node):
	"""The pairs host's `GRANTS` names on `node`: its family's, and the core's on a core node."""
	return " ".join(GRANTS[node["system"]] + (CORE_GRANTS if node.get("core") else ()))


def relay_peers(nodes):
	"""Every node's relay by its tailnet address, in nodes.toml order; a relay skips its own."""
	return " ".join(f"{name}={tailnet_ipv4(name)}:{RELAY_PORT}" for name in nodes)


def encoded(text):
	return base64.b64encode(text.encode()).decode()


def script(name, node, proxies):
	"""The whole of what runs on the machine, as one shell script."""
	family = node["system"]
	lines = [
		"set -eu",
		f"name={name}",
		f"cloud_hostname={encoded((NODES / 'debian/cloud-hostname.cfg').read_text())}",
		# A node declared one family and running another stops here, before anything is written.
		f'. /etc/os-release; case "$ID ${{ID_LIKE:-}}" in *{family}*) ;; *) echo "not {family}: $ID" >&2; exit 1;; esac',
		"old=$(hostname)",
		"mkdir -p /etc/node",
		f"printf '%s' {encoded(firewall(node))} | base64 -d > /etc/node/firewall.nft",
	]
	for source, target, mode in FILES[family]:
		lines.append(f"mkdir -p {Path(target).parent}")
		lines.append(f"printf '%s' {encoded((NODES / source).read_text())} | base64 -d > {target}")
		lines.append(f"chmod {mode} {target}")
	lines.append(SETUP[family])
	if family == "debian":
		lines.append(apt_units())
	elif family == "alpine":
		lines.append(apk_door())
	# Every node with IPv4 is a proxy; one without asks them. See spec/architecture/nodes.md.
	lines.append(proxy(family) if node.get("ipv4", True) else egress(proxies))
	if emulated(node):
		lines.append(EMULATION)
	# The old name is replaced where /etc/hosts gives it, so the machine still resolves itself.
	lines.append(
		"""awk -v o="$old" -v n="$name" '$1 !~ /^#/ { for (i = 2; i <= NF; i++) if ($i == o) $i = n } { print }' """
		"""/etc/hosts > /etc/hosts.node && cat /etc/hosts.node > /etc/hosts && rm /etc/hosts.node"""
	)
	lines.append('tailscale set --hostname="$name"')
	# The canary's Caddy admits its verdict route from the tailnet alone, so what tailscale forwards
	# into Docker keeps its 100.x source rather than being masqueraded to the bridge's gateway. The
	# canary advertises no routes; no other node is changed, since its peers may rely on today's.
	if node.get("canary") is True:
		lines.append("tailscale set --snat-subnet-routes=false")
	lines.append("nft -c -f /etc/node/firewall.nft")
	# Applied under a guard: unless a second session proves the machine is still reachable, the
	# table comes down by itself. See spec/architecture/nodes.md.
	lines.append("rm -f /run/node-firewall.ok")
	lines.append(START[family])
	lines.append(
		f"setsid sh -c 'sleep {GUARD_SECONDS}; [ -f /run/node-firewall.ok ] || nft delete table inet node' "
		"</dev/null >/dev/null 2>&1 &"
	)
	return "\n".join(lines) + "\n"


def ssh(address, command, stdin=None):
	return subprocess.run(
		["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", f"root@{address}", command],
		input=stdin,
		text=True,
	).returncode


def ssh_output(address, command, stdin=None):
	"""What the command printed, or None when it failed; its errors go to the terminal."""
	result = subprocess.run(
		["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", f"root@{address}", command],
		input=stdin,
		text=True,
		stdout=subprocess.PIPE,
	)
	return result.stdout.strip() if result.returncode == 0 else None


def put(address, path, content, mode):
	"""Writes a file on the node from stdin, so what it holds is never on a command line."""
	command = f"umask 077; cat > {path}.new && chmod {mode} {path}.new && mv {path}.new {path}"
	return ssh(address, f"sh -c {shlex.quote(command)}", content) == 0


def gh(*arguments):
	result = subprocess.run(["gh", *arguments], text=True, stdout=subprocess.PIPE)
	if result.returncode != 0:
		sys.exit(f"node: gh {arguments[0]} failed")
	return json.loads(result.stdout)


def newest_run(arch):
	"""The newest successful run of the deploy workflow on main that built host for `arch`."""
	wanted = f"deploy-host-{arch}"
	runs = gh("run", "list", "-R", REPOSITORY, "-w", WORKFLOW, "-b", "main", "-s", "success",
		"-L", "50", "--json", "databaseId")
	for run in runs:
		found = gh("api", f"repos/{REPOSITORY}/actions/runs/{run['databaseId']}/artifacts?per_page=100")
		if any(a["name"] == wanted and not a["expired"] for a in found["artifacts"]):
			return run["databaseId"]
	return None


def host_token(name, dry):
	"""HOST_TOKEN_<NAME> from secrets.json, made and stored there first when it is not."""
	return stored_secret(f"HOST_TOKEN_{name.upper()}", dry)


def stored_secret(key, dry):
	"""`key` from secrets.json, made and stored there first when it is not."""
	if os.environ.get(key):
		print(f"node: {key} is read from secrets.json")
		return os.environ[key]
	if dry:
		print(f"node: {key} is not in secrets.json; 32 random bytes would be stored there as it")
		return None
	token = secrets.token_hex(32)
	stored = subprocess.run(
		["sops", "set", "--value-stdin", "secrets.json", json.dumps([key])],
		input=json.dumps(token),
		text=True,
		cwd=ROOT,
	)
	if stored.returncode != 0:
		sys.exit(f"node: storing {key} in secrets.json failed")
	print(f"node: {key} was made and stored in secrets.json")
	return token


def relay(where, name, nodes, peers, secrets_, dry, recreate=True):
	"""Gives the relay peer, and host, what they read on one node, and with `recreate` has keeper
	start host again when its .env changed, so host reads it. False when the node could not be given
	it."""
	slot = list(nodes).index(name)
	wanted = grants(nodes[name])
	emulate = emulated(nodes[name])
	canary = canary_of(name, nodes)
	if dry:
		print(
			f"node: {name}: would, on root@{where}:\n"
			"  make the subvolume /data/apps/relay unless it is there, mode 700\n"
			"  write /data/apps/relay/secret.env, mode 600, if it differs: RELAY_SECRET=<redacted>\n"
			f"    HOST_READ_TOKEN=<redacted> RELAY_PEERS='{peers}'\n"
			"  in /data/apps/host/.env, if there is one and it differs: HOST_READ_TOKEN=<redacted>\n"
			f"    NODE_SLOT={slot} PRIVATE_SCOPES={PRIVATE_SCOPES} EMULATE='{emulate}' CANARY={canary}\n"
			f"    and {wanted} added to GRANTS, the pairs already there kept"
			+ ("\n  if host's .env changed, ask keeper to recreate host on it, as recreate-host does"
				if recreate else "")
		)
		return True
	stdin = (
		f"{secrets_['RELAY_SECRET']}\n{secrets_['HOST_READ_TOKEN']}\n{peers}\n"
		f"{slot}\n{wanted}\n{PRIVATE_SCOPES}\n{emulate}\n{canary}\n"
	)
	answer = ssh_output(where, f"sh -c {shlex.quote(RELAY)}", stdin)
	if answer is None:
		print(f"node: {name}: giving the relay its secrets failed")
		return False
	states = dict(line.split(" ", 1) for line in answer.splitlines())
	print(f"node: {name}: relay secret.env {states.get('secret')}")
	if states.get("host") == "changed" and recreate:
		print(f"node: {name}: host's .env changed; keeper recreates host to read it")
		try:
			host_api.main("recreate-host", [name], nodes)
		except SystemExit as refused:
			print(f"node: {name}: recreating host failed: {refused}; run `node recreate-host {name}`")
			return False
	elif states.get("host") == "changed":
		print(f"node: {name}: host's .env changed")
	elif states.get("host") == "absent":
		print(f"node: {name}: host has no .env yet; run again after `node host {name}`")
	return True


def environment(name, nodes, token, read_token):
	"""host's `.env`. LAN_ADDRESS and RESOLVER_UPSTREAMS are left out: a cloud node has no LAN and
	runs no resolver."""
	values = {
		"NODE": name,
		"NODE_SLOT": list(nodes).index(name),
		"HOST_TOKEN": token,
		"HOST_READ_TOKEN": read_token,
		"GRANTS": grants(nodes[name]),
		"EMULATE": emulated(nodes[name]),
		"CANARY": canary_of(name, nodes),
		"PRIVATE_SCOPES": PRIVATE_SCOPES,
		"PRIVATE_SUFFIX": PRIVATE_SUFFIX,
		"PUBLIC_SUFFIX": PUBLIC_SUFFIX,
		"PRIVATE_SOURCES": PRIVATE_SOURCES,
		"TUNNEL_SOURCE": TUNNEL_SOURCE,
		"ACME_EMAIL": os.environ["ACME_EMAIL"],
		"GITHUB_ACTIONS_TOKEN": os.environ["GITHUB_ACTIONS_TOKEN"],
		"DEPLOY_SOURCES": DEPLOY_SOURCES,
	}
	return "".join(f"{key}={value}\n" for key, value in values.items())


def start_host(name, run, dry):
	"""Brings up the first host on a fresh node and hands it a run; keeper replaces it after that."""
	missing = [key for key in SECRETS if not os.environ.get(key)]
	if missing:
		sys.exit(f"node: {', '.join(missing)} not in the environment; they come from secrets.json")
	machine = ssh_output(name, "uname -m")
	if machine is None:
		sys.exit(f"node: root@{name} did not answer")
	if machine not in ARCHES:
		sys.exit(f"node: {name} is {machine}, for which nothing is built")
	arch = ARCHES[machine]
	artifact = f"deploy-host-{arch}"
	run = run or newest_run(arch)
	if run is None:
		message = f"no successful {WORKFLOW} run on main has an unexpired {artifact}"
		if not dry:
			sys.exit(f"node: {message}; name one with --run")
		print(f"node: {message}")
		run = "RUN_ID"
	print(f"node: host on {name}, {arch}, from run {run} of {REPOSITORY}")
	token = host_token(name, dry)
	shared = {key: stored_secret(key, dry) for key in RELAY_SECRETS}
	nodes = load_nodes()
	peers = relay_peers(nodes)
	# By hand, so the canary is not waited for; see `canary_of`.
	notice = json.dumps({"run": run, "repository": REPOSITORY, "host_replaced": True, "by_hand": True})
	if dry:
		print(
			f"node: would, on root@{name}:\n"
			f"  check /data is mounted; make `edge` at {EDGE_SUBNET} unless it is there\n"
			"  make the subvolumes /data/apps/host and /data/apps/caddy unless they are there\n"
			"  write /data/apps/caddy/secret.env, mode 600: INTERNAL_TOKEN from secrets.json\n"
			f"  load {artifact} from run {run}, downloaded here by gh, as host:local\n"
			f"  write /data/apps/host/docker-compose.yml from {COMPOSE.relative_to(ROOT)}\n"
			f"  write /data/apps/host/.env, mode 600: NODE={name} NODE_SLOT={list(nodes).index(name)}\n"
			f"    PRIVATE_SCOPES={PRIVATE_SCOPES} PRIVATE_SUFFIX={PRIVATE_SUFFIX}\n"
			f"    PUBLIC_SUFFIX={PUBLIC_SUFFIX} PRIVATE_SOURCES={PRIVATE_SOURCES}\n"
			f"    TUNNEL_SOURCE={TUNNEL_SOURCE} DEPLOY_SOURCES='{DEPLOY_SOURCES}',\n"
			f"    HOST_TOKEN_{name.upper()} as HOST_TOKEN, HOST_READ_TOKEN,\n"
			f"    GRANTS='{grants(nodes[name])}', EMULATE='{emulated(nodes[name])}',\n"
			f"    CANARY={canary_of(name, nodes)},\n"
			"    ACME_EMAIL, GITHUB_ACTIONS_TOKEN\n"
			f"  docker compose up -d in /data/apps/host, waiting {WAIT_SECONDS}s for it to run\n"
			f"  POST {notice} to http://host:{HOST_PORT}/notice from {CURL}"
		)
		relay(name, name, nodes, peers, shared, dry, recreate=False)
		return

	if ssh(name, "sh -s", PREPARE) != 0:
		sys.exit(f"node: preparing {name} failed")
	secret = os.environ["INTERNAL_TOKEN"] + "\n"
	state = ssh_output(name, f"sh -c {shlex.quote(CADDY_SECRET)}", secret)
	if state is None:
		sys.exit(f"node: writing Caddy's secret.env on {name} failed")
	print(f"node: Caddy's secret.env {'written' if state == 'written' else 'already current'}")

	scratch = tempfile.mkdtemp(prefix="node-host-")
	try:
		fetched = subprocess.run(
			["gh", "run", "download", str(run), "-R", REPOSITORY, "-n", artifact, "-D", scratch]
		)
		if fetched.returncode != 0:
			sys.exit(f"node: downloading {artifact} from run {run} failed")
		with open(Path(scratch) / "image.tar", "rb") as image:
			loaded = subprocess.run(
				["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", f"root@{name}", "docker load"],
				stdin=image,
			)
		if loaded.returncode != 0:
			sys.exit(f"node: loading host's image on {name} failed")
	finally:
		shutil.rmtree(scratch, ignore_errors=True)

	if not put(name, "/data/apps/host/docker-compose.yml", COMPOSE.read_text(), "644"):
		sys.exit(f"node: writing host's docker-compose.yml on {name} failed")
	if not put(name, "/data/apps/host/.env", environment(name, nodes, token, shared["HOST_READ_TOKEN"]), "600"):
		sys.exit(f"node: writing host's .env on {name} failed")
	if not relay(name, name, nodes, peers, shared, dry, recreate=False):
		sys.exit(f"node: giving the relay its secrets on {name} failed")
	if ssh(name, "cd /data/apps/host && docker compose up -d") != 0:
		sys.exit(f"node: starting host on {name} failed")
	if ssh(name, "sh -s", WAIT) != 0:
		sys.exit(f"node: host on {name} is not running after {WAIT_SECONDS}s")

	networks = "{{range $name, $_ := .NetworkSettings.Networks}}{{$name}} {{end}}"
	network = ssh_output(name, f"docker inspect host -f '{networks}'")
	if not network:
		sys.exit(f"node: host on {name} is on no network")
	# host_replaced: a run that rebuilt host otherwise waits for keeper, which a fresh node lacks.
	post = [
		"docker", "run", "--rm", "--network", network.split()[0], CURL,
		"-sS", "--retry", "10", "--retry-connrefused", "--retry-delay", "1",
		"-X", "POST", "-H", "content-type: application/json", "--data", notice,
		f"http://host:{HOST_PORT}/notice",
	]
	answer = ssh_output(name, shlex.join(post))
	if answer is None:
		sys.exit(f"node: host on {name} did not take run {run}")
	print(f"node: host on {name} answered {answer}")


def main():
	arguments = sys.argv[1:]
	if arguments[:1] and arguments[0] in host_api.VERBS:
		nodes = load_nodes()
		host_api.main(arguments[0], arguments[1:], nodes)
		return
	if arguments[:1] == ["host"]:
		rest = arguments[1:]
		run = rest[rest.index("--run") + 1] if "--run" in rest else None
		names = [a for a in rest if not a.startswith("-") and a != run]
		nodes = load_nodes()
		if len(names) != 1 or names[0] not in nodes or (run is not None and not run.isdigit()):
			sys.exit(f"node: host takes one of {', '.join(nodes)}, and --run a run's number")
		start_host(names[0], int(run) if run else None, "--dry-run" in rest or "-n" in rest)
		return
	dry = "--dry-run" in arguments or "-n" in arguments
	address = arguments[arguments.index("--address") + 1] if "--address" in arguments else None
	nodes = load_nodes()
	names = [a for a in arguments if not a.startswith("-") and a != address]
	if "--all" in arguments:
		names = list(nodes)
	if not names or any(name not in nodes for name in names) or (address and len(names) > 1):
		sys.exit(f"node: name one of {', '.join(nodes)} or --all; --address takes one")

	proxies = proxy_addresses(nodes) if any(not nodes[n].get("ipv4", True) for n in names) else []
	# Made once, before the loop, or each node would be given a value of its own.
	shared = {key: stored_secret(key, dry) for key in RELAY_SECRETS}
	peers = relay_peers(nodes)
	failed = []
	for name in names:
		node = nodes[name]
		where = address or name
		if dry:
			print(f"# node {name}, {node['system']}, at root@{where}\n{script(name, node, proxies)}")
			relay(where, name, nodes, peers, shared, dry)
			continue
		print(f"node: {name} at root@{where}")
		if ssh(where, "sh -s", script(name, node, proxies)) != 0:
			failed.append(name)
			continue
		# A new session, over the tailnet, is what the firewall has to let through.
		if ssh(where, "touch /run/node-firewall.ok") != 0:
			print(f"node: {name} refused a second session; its firewall comes down in {GUARD_SECONDS}s")
			failed.append(name)
			continue
		if not relay(where, name, nodes, peers, shared, dry):
			failed.append(name)
			continue
		print(f"node: {name} is set up")
	if failed:
		sys.exit(f"node: failed on {', '.join(failed)}")


if __name__ == "__main__":
	main()
